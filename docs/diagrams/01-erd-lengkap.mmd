erDiagram
    categories {
        bigint id PK
        varchar name UK
        boolean is_active 
    }
    books {
        bigint id PK
        bigint category_id FK
        varchar title 
        varchar author 
        varchar isbn UK
        varchar publisher 
        smallint publication_year 
        boolean is_active 
    }
    users {
        bigint id PK
        varchar name 
        varchar email UK
        varchar student_number UK
        text password_hash 
        enum role 
        boolean is_active 
    }
    loan_requests {
        bigint id PK
        bigint student_id FK
        bigint book_id FK
        bigint reviewed_by FK
        bigint policy_id FK
        enum status 
        timestamptz requested_at 
        timestamptz reviewed_at 
        timestamptz pickup_deadline 
        timestamptz closed_at 
        text reason 
    }
    loans {
        bigint id PK
        bigint loan_request_id FK
        bigint policy_id FK
        bigint issued_by FK
        bigint returned_to FK
        timestamptz borrowed_at 
        date due_date 
        timestamptz returned_at 
        text return_condition 
    }
    fines {
        bigint id PK
        bigint loan_id FK
        integer overdue_days 
        integer daily_rate 
        bigint total_amount 
        timestamptz created_at 
        timestamptz paid_at 
        bigint payment_recorded_by FK
        varchar payment_reference 
    }
    lending_policies {
        bigint id PK
        timestamptz effective_at UK
        bigint created_by FK
        integer max_books 
        integer loan_days 
        integer daily_fine 
        integer pickup_days 
    }
    categories ||..o{ books : "category_id"
    books ||..o{ loan_requests : "book_id"
    users ||..o{ loan_requests : "student_id"
    loan_requests ||..o| loans : "loan_request_id"
    loans ||..o| fines : "loan_id"
    users ||..o{ lending_policies : "created_by"
    lending_policies |o..o{ loan_requests : "policy_id"
    lending_policies ||..o{ loans : "policy_id"
    users |o..o{ loan_requests : "reviewed_by"
    users ||..o{ loans : "issued_by"
    users |o..o{ loans : "returned_to"
    users |o..o{ fines : "payment_recorded_by"
